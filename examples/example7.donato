class Node {
  int value;
  Node* next;
  Node* prev;
public:
  Node(int value){
    this.next = nullptr<Node>;
    this.prev = nullptr<Node>;
    this.value = value;
    return;
  }

  function
  void setNext(Node* node){
    this.next = node;
    return;
  }

  function
  Node* getNext(){
    return this.next;
  }

  function
  void setPrev(Node* node){
    this.prev = node;
    return;
  }

  function
  Node* getPrev(){
    return this.prev;
  }

  function
  int getValue(){
    return this.value;
  }
}

class LinkedList {
  Node* head;
  Node* tail;
  int size;
public:
  LinkedList(){
    this.head = nullptr<Node>;
    this.tail = nullptr<Node>;
    this.size = 0;
    return;
  }

  function
  void add(int value){
    Node* newNode = new Node(value);
  
    if(this.head == nullptr<Node>){
      this.head = newNode;
      this.tail = newNode;
      this.size = this.size + 1;
      return;
    }
    
    ref Node tailRef = *this.tail;
    ref Node newRef = *newNode;
    
    tailRef.setNext(newNode);
    newRef.setPrev(this.tail);
    this.tail = newNode;
    this.size = this.size + 1;
    return;
  }

  function
  void insertAt(int index, int value){
    if(index < 0){
      return;
    }
    if(index > this.size){
      return;
    }
    
    if(index == this.size){
      this.add(value);
      return;
    }
    
    if(index == 0){
      Node* newNode = new Node(value);
      ref Node newRef = *newNode;
      
      if(this.head != nullptr<Node>){
        ref Node headRef = *this.head;
        newRef.setNext(this.head);
        headRef.setPrev(newNode);
      }
      
      this.head = newNode;
      if(this.tail == nullptr<Node>){
        this.tail = newNode;
      }
      this.size = this.size + 1;
      return;
    }
    
    Node* current = this.head;
    int i = 0;
    
    while(i < index){
      if(current == nullptr<Node>){
        return;
      }
      ref Node currentRef = *current;
      current = currentRef.getNext();
      i = i + 1;
    }
    
    if(current != nullptr<Node>){
      Node* newNode = new Node(value);
      ref Node newRef = *newNode;
      ref Node currentRef = *current;
      
      Node* prevNode = currentRef.getPrev();
      
      newRef.setNext(current);
      newRef.setPrev(prevNode);
      currentRef.setPrev(newNode);
      
      if(prevNode != nullptr<Node>){
        ref Node prevRef = *prevNode;
        prevRef.setNext(newNode);
      }
      
      this.size = this.size + 1;
    }
    return;
  }

  function
  int getSize(){
    return this.size;
  }

  function
  void printList(){
    Node* current = this.head;
    
    while(current != nullptr<Node>){
      ref Node n = *current;
      print(n.getValue());
      current = n.getNext();
    }
    return;
  }

  function
  void printReverse(){
    Node* current = this.tail;
    
    while(current != nullptr<Node>){
      ref Node n = *current;
      print(n.getValue());
      current = n.getPrev();
    }
    return;
  }

  function
  void destroy(){
    Node* current = this.head;
    
    while(current != nullptr<Node>){
      ref Node currentRef = *current;
      Node* next = currentRef.getNext();
      
      delete current;
      
      current = next;
    }
    
    this.head = nullptr<Node>;
    this.tail = nullptr<Node>;
    this.size = 0;
    return;
  }
}

function 
int main(){
  LinkedList* list = new LinkedList();
  ref LinkedList l = *list;

  l.add(10);
  l.add(20);
  l.add(30);
  
  
  print(-100);
  l.printList(); 
  
  
  print(-200);
  print(l.getSize()); 
  
  print(-300);
  l.insertAt(1, 15); 
  
  print(-400);
  l.printList(); 
  
  print(-500);
  print(l.getSize()); 
  
  print(-600);
  l.printReverse(); 

  l.destroy();

  return 0;
}