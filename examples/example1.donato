function
int main(){
  // Currently you cannot declare variables without initializing them.
  int x = 0;
  int y = x;

  print(-1000);
  print(x);
  print(y);

  // inline expressions
  // if inline
  x = 2 + if y > 3 then y else y - 1;
  print(-2000);
  print(x);

  // let inline
  int z = let a = 5, b = 9 in  a + x - let a = 7 in  a + b;
  // If the variables in the let have the same names as
  // the various nested lets, the last associated value is taken.
  print(-3000);
  print(z);

  int q = 1 + let v = 1, d = 10 in v + (let v = 0 in v * d) + v;
  print(-4000);
  print(q);


  // Prints were developed primarily for debugging,
  // they only accept 64-bit integers (int or int64).
  double db = 1.1;
  bool boolValue = true;
  int8 int8Value = 10;
  int16 int16Value = 10;
  int32 int32Value = 10;

  //int8 int8ValueError = 128;  !!Runtime Error: Truncation caused data loss
  // This error is present in all types if the space is exceeded

  return 0;
}